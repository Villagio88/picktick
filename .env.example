# Kopieren nach .env und anpassen. Die Datei .env gehört nie ins Repo.
PICKTICK_PASSWORT=mindestens-zwoelf-zeichen-lang
# Optional, voller Zugriff für Skripte über die API:
PICKTICK_API_SCHLUESSEL=
# Optional, nur Einträge erfassen (für Kurzbefehle auf dem Handy):
PICKTICK_ERFASSEN_SCHLUESSEL=
# 1, wenn ein Reverse Proxy mit HTTPS davor steht:
PICKTICK_HINTER_PROXY=0
